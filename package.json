{
  "name": "concurso-simulador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "catalog:seed": "tsx scripts/seed-catalog.ts",
    "db:generate": "prisma generate",
    "import:exam": "tsx scripts/import-exam.ts",
    "review:exam": "tsx scripts/review-exam.ts",
    "fix:bb-artifacts": "tsx scripts/fix-bb-artifacts.ts",
    "sync:bb-visuals": "tsx scripts/sync-bb-visual-assets.ts",
    "publish:bb-overrides": "tsx scripts/publish-bb-overrides.ts",
    "publish:transpetro-mechanical": "tsx scripts/publish-transpetro-mechanical.ts",
    "generate:exam": "tsx scripts/generate-exam.ts",
    "monitor:sources": "tsx scripts/monitor-sources.ts",
    "catalog:sync": "tsx scripts/catalog-sync.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "production:check": "tsx scripts/production-check.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/worker/index.js",
    "worker:start": "node dist/worker/index.js",
    "cron:build": "esbuild src/cron/monitor.ts src/cron/catalog.ts --bundle --platform=node --target=node20 --packages=external --outdir=dist/cron",
    "cron:monitor": "node dist/cron/monitor.js",
    "cron:catalog": "node dist/cron/catalog.js",
    "audit:production": "npm audit --omit=dev",
    "docker:build:web": "docker build -f Dockerfile.web -t nota-de-banca-web:local .",
    "docker:build:worker": "docker build -f Dockerfile.worker -t nota-de-banca-worker:local ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.81.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
